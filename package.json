{
  "name": "isculptures-interactive",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-worker.mjs",
    "build:web": "node scripts/sync-redirects.mjs --check && next build && node scripts/check-seo.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir dist/enquiry-worker",
    "deploy:worker": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "enquiries": "node scripts/enquiries.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "gsap": "3.15.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "wrangler": "^4.129.0"
  }
}
