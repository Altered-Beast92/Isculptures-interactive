{
  "name": "isculptures-interactive",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-worker.mjs",
    "build:web": "next build",
    "build:worker": "wrangler deploy --dry-run --outdir dist/enquiry-worker",
    "deploy:worker": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "enquiries": "node scripts/enquiries.mjs"
  },
  "dependencies": {
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "gsap": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/three": "latest",
    "typescript": "latest",
    "wrangler": "^4.129.0"
  }
}
