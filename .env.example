# Vercel: set this to the deployed Cloudflare Worker URL + /api/enquiry, then rebuild.
# Same-origin default is retained for local and combined website/API hosting.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=/api/enquiry
# Keep false for the private draft. Set true only for the approved domain cutover.
SITE_INDEXABLE=false
# Runtime secrets go in the hosting provider, never NEXT_PUBLIC variables.
ENQUIRIES_ENABLED=false
ENQUIRY_TO=info@isculptures.com.au
ENQUIRY_FROM=
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
FILE_LINK_SECRET=
ENQUIRY_ADMIN_TOKEN=
# Cloudflare runtime only: comma-separated exact Vercel/custom origins, no trailing slash.
# An empty value disables the standalone API. Never allow all *.vercel.app sites.
ENQUIRY_ALLOWED_ORIGINS=
# Microsoft Clarity project id. Unset simply omits the tag from the static export.
NEXT_PUBLIC_CLARITY_ID=
# Etsy seller app, for syncing listing data to the site and creating draft listings.
# Real values belong in .env (gitignored), never here. Tokens are written by
# scripts/etsy-auth.mjs; the shop id is the shop name as it appears in its URL.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
