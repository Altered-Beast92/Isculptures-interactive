{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pages/events-custom",
      "destination": "/pages/events-custom-gifts",
      "statusCode": 301
    },
    {
      "source": "/products/wholesale",
      "destination": "/enquiry",
      "statusCode": 301
    },
    {
      "source": "/products/bonbonniere-gifts",
